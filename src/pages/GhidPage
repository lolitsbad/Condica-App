const SCRIPT_JS = '  function toggleSection(header) { header.parentElement.classList.toggle(\'open\'); updateProgress(); }\n  function showTab(evt, panelId) {\n    evt.target.parentElement.querySelectorAll(\'.tab-btn\').forEach(t => t.classList.remove(\'active\'));\n    evt.target.classList.add(\'active\');\n    document.querySelectorAll(\'#programari .tab-panel\').forEach(p => p.classList.remove(\'active\'));\n    document.getElementById(panelId).classList.add(\'active\');\n  }\n  function updateProgress() {\n    const total = document.querySelectorAll(\'main section\').length;\n    const open = document.querySelectorAll(\'main section.open\').length;\n    document.getElementById(\'progressLabel\').textContent = open + \' din \' + total + \' secțiuni deschise\';\n    document.getElementById(\'progressFill\').style.width = (open / total * 100) + \'%\';\n  }\n  const navLinks = document.querySelectorAll(\'#navList a\');\n  const sections = document.querySelectorAll(\'main section\');\n  const spyObserver = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        navLinks.forEach(l => l.classList.remove(\'active\'));\n        const link = document.querySelector(\'#navList a[data-target="\' + entry.target.id + \'"]\');\n        if (link) link.classList.add(\'active\');\n      }\n    });\n  }, { rootMargin: \'-20% 0px -70% 0px\' });\n  sections.forEach(s => spyObserver.observe(s));\n  navLinks.forEach(link => {\n    link.addEventListener(\'click\', () => {\n      const section = document.getElementById(link.dataset.target);\n      if (section && !section.classList.contains(\'open\')) { section.classList.add(\'open\'); updateProgress(); }\n    });\n  });\n  document.getElementById(\'activare\').classList.add(\'open\');\n  updateProgress();\n\n  function bookSlot(el) {\n    if (el.classList.contains(\'filled\')) return;\n    el.classList.add(\'filled\');\n    el.querySelector(\'.status\').textContent = \'Rezervat — chiar tu\';\n  }\n  function sendChatDemo() {\n    const input = document.getElementById(\'chatInput\');\n    const text = input.value.trim();\n    if (!text) return;\n    const body = document.getElementById(\'chatBody\');\n    body.innerHTML = \'\';\n    const userBubble = document.createElement(\'div\');\n    userBubble.className = \'demo-bubble\';\n    userBubble.textContent = text;\n    body.appendChild(userBubble);\n    input.value = \'\'; input.disabled = true;\n    setTimeout(() => {\n      const reply = document.createElement(\'div\');\n      reply.className = \'demo-bubble reply\';\n      reply.textContent = \'✓ Programare creată — exact din mesajul tău\';\n      body.appendChild(reply);\n      requestAnimationFrame(() => reply.classList.add(\'show\'));\n      input.disabled = false;\n    }, 700);\n  }\n  function updateRoi() {\n    const calls = parseInt(document.getElementById(\'roiCalls\').value);\n    const minutes = parseInt(document.getElementById(\'roiMinutes\').value);\n    document.getElementById(\'roiCallsVal\').textContent = calls;\n    document.getElementById(\'roiMinutesVal\').textContent = minutes;\n    document.getElementById(\'roiResult\').textContent = ((calls * minutes * 4.33) / 60).toFixed(1) + \' ore/lună\';\n  }\n  updateRoi();\n\n  // 3D tilt for all [data-tilt] elements\n  document.querySelectorAll(\'[data-tilt]\').forEach(el => {\n    el.classList.add(\'tilt\');\n    el.addEventListener(\'mousemove\', (e) => {\n      const rect = el.getBoundingClientRect();\n      const px = (e.clientX - rect.left) / rect.width - 0.5;\n      const py = (e.clientY - rect.top) / rect.height - 0.5;\n      el.style.transform = \'perspective(700px) rotateX(\' + (-py * 10) + \'deg) rotateY(\' + (px * 10) + \'deg) scale(1.03)\';\n      const glow = el.dataset.glow || \'var(--violet)\';\n      el.style.boxShadow = \'0 16px 30px -6px \' + glow.replace(\'var(\', \'\').replace(\')\', \'\') ? \'0 16px 30px -8px rgba(0,0,0,0.15)\' : \'\';\n    });\n    el.addEventListener(\'mouseleave\', () => { el.style.transform = \'perspective(700px) rotateX(0) rotateY(0) scale(1)\'; });\n  });\n\n  // hero group parallax\n  const heroComp = document.getElementById(\'heroComp\');\n  const heroGrid = document.getElementById(\'heroGrid\');\n  if (heroComp && heroGrid) {\n    heroComp.addEventListener(\'mousemove\', (e) => {\n      const rect = heroComp.getBoundingClientRect();\n      const px = (e.clientX - rect.left) / rect.width - 0.5;\n      const py = (e.clientY - rect.top) / rect.height - 0.5;\n      heroGrid.style.transform = \'rotateY(\' + (px * 8) + \'deg) rotateX(\' + (-py * 6) + \'deg)\';\n    });\n    heroComp.addEventListener(\'mouseleave\', () => { heroGrid.style.transform = \'rotateY(0) rotateX(0)\'; });\n  }';

export default function GhidPage() {
  const rootRef = useRef(null);

  useEffect(() => {
    const styleEl = document.createElement('style');
    styleEl.id = 'ghid-style';
    styleEl.textContent = STYLE_CSS;
